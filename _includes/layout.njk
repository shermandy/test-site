<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Test Site Title</title>
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", (user) => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </head>
  <body>
    <header>
      <h1>Test Site</h1>
      <nav>
        <ul>
          {% for item in collections.nav | sortByOrder %}
            <li>
              <a href="{{ item.url }}" {% if item.url == page.url %}aria-current="page"{% endif %}>
                {{ item.data.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </header>

    <main>
      <!-- Renders standard Markdown body content if present -->
      {% if content %}
        <div class="page-body">
          {{ content | safe }}
        </div>
      {% endif %}
      <!-- Loops through dynamic Decap CMS sections if defined -->
      {% if blocks %}
        {% for block in blocks %}
          {% include "blocks/" + block.type + ".njk" %}
        {% endfor %}
      {% endif %}
    </main>
  </body>
</html>