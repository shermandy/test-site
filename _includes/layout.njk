<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Test Site Title</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    {% include "components/header.njk" %}
    <main>
      <!-- Renders standard Markdown body content if present -->
      {% if content %}
        <div class="page-body">
          {{ content | safe }}
        </div>
      {% endif %}
      <!-- Loops through dynamic Decap CMS sections if defined -->
      {% if blocks %}
        {% for block in blocks %}
          {% include "blocks/" + block.type + ".njk" %}
        {% endfor %}
      {% endif %}
    </main>
    {% include "components/footer.njk" %}
  </body>
</html>