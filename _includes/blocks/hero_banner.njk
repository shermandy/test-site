<section class="hero-banner">
  {% if block.heading %}
    <h2>{{ block.heading }}</h2>
  {% endif %}
    <p>{{ block.content }}</p>
  <div class="hero-buttons">
    {% for link in block.links %}
        <a href="{{ link.url }}" class="link-btn" target="{{ link.target }}">{{ link.text }}</a> 
    {% endfor %}
  </div>
</section>